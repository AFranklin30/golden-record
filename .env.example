# Copy to .env and replace every replace-me value there.
# Real passwords, PEM keys, and connection strings stay out of this file.
#
# Local development uses the values below.
# Local production-mode keeps the same names and sets NODE_ENV=production
# and CORS_ORIGIN to the Express origin, for example http://127.0.0.1:3457.
# The Render demonstration and a later production host set NODE_ENV=production,
# CORS_ORIGIN to that exact https origin, and DATABASE_URL to the
# golden_record_app direct Neon URL. They do not set DEV_ORG_API_KEY.

# Required to start, in local, demonstration, and production.
DATABASE_URL=postgresql://golden_record_app:replace-me@localhost:5432/golden_record
FIRESTORE_PROJECT_ID=replace-me
# PEM text. Line breaks may be written as \n. Never commit a real key.
JWT_PRIVATE_KEY=replace-me
JWT_PUBLIC_KEY=replace-me

# Demonstration and production set NODE_ENV=production.
# CORS_ORIGIN is the exact browser origin, including the scheme.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Optional. Defaults are 60000 and 100.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Optional. Used for a household claim link. Default is this example URL.
CLAIM_URL_BASE=https://example.com/claim

# Local scripts and tests only. The server does not read this.
DEV_ORG_API_KEY=replace-me
